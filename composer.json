{
    "name": "kendenigerian/payzephyr",
    "description": "A unified payment abstraction layer for Laravel supporting multiple providers (Paystack, Flutterwave, Monnify, Stripe, PayPal, Square, OPay, Mollie, Paddle, Razorpay) with automatic fallback and webhooks.",
    "keywords": [
        "laravel",
        "payment",
        "paystack",
        "flutterwave",
        "stripe",
        "paypal",
        "monnify",
        "mollie",
        "square",
        "opay",
        "paddle",
        "razorpay",
        "payment-gateway",
        "payments",
        "webhook",
        "fintech",
        "laravel-package"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nwaneri Chukwunyere Kenneth",
            "email": "ken.de.nigerian@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/ken-de-nigerian/payzephyr",
    "support": {
        "issues": "https://github.com/ken-de-nigerian/payzephyr/issues",
        "source": "https://github.com/ken-de-nigerian/payzephyr"
    },
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/prompts": "^0.3",
        "nesbot/carbon": "^3.0",
        "psr/http-message": "^1.1|^2.0",
        "stripe/stripe-php": "^21.0",
        "symfony/http-foundation": "^7.0|^8.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "laravel/pint": "1.26.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^5.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "KenDeNigerian\\PayZephyr\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "KenDeNigerian\\PayZephyr\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --coverage-clover coverage.xml",
        "analyse": "vendor/bin/phpstan analyse src",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "KenDeNigerian\\PayZephyr\\PaymentServiceProvider"
            ],
            "aliases": {
                "Payment": "KenDeNigerian\\PayZephyr\\Facades\\Payment"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
